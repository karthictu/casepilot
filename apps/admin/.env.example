# Base URL of the casepilot API. Leave empty to call the same origin, which in
# development means the Vite proxy (see vite.config.ts) and in the container
# means the nginx proxy (see nginx.conf).
VITE_API_BASE_URL=

# Optional bearer token, sent as `Authorization: Bearer <token>` on every API
# call (including the chat stream). Only needed when the API runs with
# CASEPILOT_AUTH_MODE=jwt. Note: anything prefixed VITE_ is embedded in the
# built bundle, so never put a long-lived production secret here.
VITE_API_TOKEN=

# Dev server only: where the Vite proxy forwards /api, /a2a, /mcp,
# /.well-known and /health. Defaults to http://localhost:8000.
# VITE_API_PROXY_TARGET=http://localhost:8000
