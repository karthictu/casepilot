# Copy to .env. Every integration is off by default; the defaults run fully offline on mocks.

# ── Database ─────────────────────────────────────────────────
CASEPILOT_DATABASE_URL=postgresql+asyncpg://casepilot:casepilot@localhost:5432/casepilot
# Quick start without Postgres:
# CASEPILOT_DATABASE_URL=sqlite+aiosqlite:///./casepilot.db
# CASEPILOT_AUTO_CREATE_TABLES=true
CASEPILOT_SEED_ON_STARTUP=false

# ── Behaviour ────────────────────────────────────────────────
CASEPILOT_WRITE_MODE=shadow                 # shadow | live
CASEPILOT_HITL_CONFIDENCE_THRESHOLD=0.85
CASEPILOT_OWNED_REASONS=["booking_create","booking_amend","booking_cancel"]
CASEPILOT_AGENT_MODULES=["app.agents.booking","app.agents.tracking"]

# ── Auth ─────────────────────────────────────────────────────
CASEPILOT_AUTH_MODE=mock                    # mock | jwt
# CASEPILOT_JWT_SECRET=change-me            # HS256, or:
# CASEPILOT_JWT_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
# CASEPILOT_JWT_AUDIENCE=casepilot
# CASEPILOT_JWT_ISSUER=https://your-idp.example.com/

# ── Agent runtime + LLM ──────────────────────────────────────
CASEPILOT_AGENT_RUNTIME=native              # native | adk (Google ADK)
CASEPILOT_LLM_PROVIDER=mock                 # mock | litellm
# LiteLLM model strings: openai/<model>, bedrock/<model-id>, azure/<deployment>, anthropic/<model>, ollama/<model>
CASEPILOT_MODEL_INTENT=openai/gpt-4o-mini
CASEPILOT_MODEL_EXTRACTION=openai/gpt-4o-mini
CASEPILOT_MODEL_REASONING=openai/gpt-4o
# Provider credentials use LiteLLM's standard variables, e.g. OPENAI_API_KEY, AWS_REGION_NAME, AZURE_API_KEY.
# Or send everything through a LiteLLM proxy:
# CASEPILOT_LITELLM_API_BASE=http://localhost:4000
# CASEPILOT_LITELLM_API_KEY=

# ── Memory ───────────────────────────────────────────────────
CASEPILOT_MEMORY_BACKEND=inmemory           # inmemory | mem0
# CASEPILOT_MEM0_CONFIG_JSON={"vector_store": {"provider": "pgvector", "config": {...}}}

# ── Case source ──────────────────────────────────────────────
CASEPILOT_CASE_SOURCE=mock                  # mock | salesforce
# CASEPILOT_SALESFORCE_LOGIN_URL=https://login.salesforce.com
# CASEPILOT_SALESFORCE_CLIENT_ID=
# CASEPILOT_SALESFORCE_USERNAME=
# CASEPILOT_SALESFORCE_PRIVATE_KEY_PATH=./secrets/salesforce.key
# CASEPILOT_SALESFORCE_CASE_FILTER=Origin = 'Email' AND Status = 'New'

# ── Observability ────────────────────────────────────────────
CASEPILOT_LANGFUSE_ENABLED=false
# CASEPILOT_LANGFUSE_PUBLIC_KEY=
# CASEPILOT_LANGFUSE_SECRET_KEY=
# CASEPILOT_LANGFUSE_HOST=http://localhost:3000

# ── Temporal ─────────────────────────────────────────────────
CASEPILOT_TEMPORAL_ENABLED=false
CASEPILOT_TEMPORAL_ADDRESS=localhost:7233
CASEPILOT_TEMPORAL_NAMESPACE=default
CASEPILOT_TEMPORAL_TASK_QUEUE=casepilot
# Temporal Cloud:
# CASEPILOT_TEMPORAL_ADDRESS=<namespace>.<account>.tmprl.cloud:7233
# CASEPILOT_TEMPORAL_API_KEY=
